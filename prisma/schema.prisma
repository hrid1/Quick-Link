

// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL") 
}


model Link {
  id          String   @id @default(uuid())
  originalUrl String
  shortCode   String   @unique
  alias       String?
  maxClicks   Int?
  expiresAt   DateTime
  clicks      Int     @default(0) 
  createdAt   DateTime @default(now())
}