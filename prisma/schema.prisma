

// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL") 
}

model Link {
  id          String   @id @default(uuid())
  originalUrl String
  shortCode   String   @unique
  expiresAt   DateTime
  createdAt   DateTime @default(now())
}