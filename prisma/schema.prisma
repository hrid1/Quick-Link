// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db" 
}

model Link {
  id          String   @id @default(uuid())
  originalUrl String
  shortCode   String   @unique
  expiresAt   DateTime
  createdAt   DateTime @default(now())
}